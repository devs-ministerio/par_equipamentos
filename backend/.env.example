# Copie para .env (nunca versionar o .env de verdade) e preencha com os
# dados reais -- local ou do Railway.

# Obrigatoria. Local: seu Postgres. No Railway: use a referencia
# ${{Postgres.DATABASE_URL}} em vez de colar a URL na mao.
DATABASE_URL=postgresql+psycopg://postgres:SENHA@localhost:5432/SIGEO-Sistema-de-Informacao-de-Equipamentos-Oncologicos

# Opcional (Plan Mode database, Bloco 1: separacao de privilegio). Em
# producao/Neon, credencial de um role dedicado a migration (dono do
# schema, unico com DDL) -- ver "Roles de banco" no README/CLAUDE.md.
# Vazia, o Alembic usa o mesmo DATABASE_URL de runtime (ok em local/teste,
# onde um unico Postgres nao tem essa separacao de role).
DATABASE_URL_MIGRATION=

# Origens autorizadas a chamar a API (CORS), separadas por virgula.
# Em producao precisa conter a URL do frontend na Vercel, senao o navegador
# bloqueia as requisicoes. Ex.: https://analise-de-meritos-api.vercel.app
CORS_ORIGINS=http://localhost:5173

# Obrigatorio para login e rotas autenticadas.
JWT_SECRET=

# Opcional -- so necessaria pra scripts/validar_convenios.py (consulta de
# convenio/instrumento legado do SICONV por numero). Chave GRATUITA de
# autoatendimento, gerada em ~1 min com login gov.br em
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=
