%% Modelo ER -- Radar de Convênios (ver modelo_er.md pro detalhe de cada
%% campo/decisão). Só o domínio "monitoramento de equipamento" -- schema
%% completo em backend/app/db/models.py.
erDiagram
    USER ||--o{ EVENTO_MARCO : "autor_id"
    USER ||--o{ AUDIT_LOG : "user_id"
    USER ||--o{ PROPOSTA_CANDIDATA : "revisado_por"
    USER ||--o{ NOTIFICACAO : "nivel_minimo (RBAC, a definir)"

    MARCO_CATALOGO ||--o{ EVENTO_MARCO : "marco_id"

    INSTRUMENTO_EQUIPAMENTO ||--o{ EVENTO_MARCO : "instrumento_id"
    INSTRUMENTO_EQUIPAMENTO ||--o{ ACAO_MONITORAMENTO : "instrumento_id"
    INSTRUMENTO_EQUIPAMENTO ||--o{ AUDIT_LOG : "entity_id (entity_name=instrumento_equipamento)"
    INSTRUMENTO_EQUIPAMENTO ||--o{ NOTIFICACAO : "entidade_id (tipo=atualizacao_api|edicao_manual)"

    PROPOSTA_CANDIDATA ||--o{ NOTIFICACAO : "entidade_id (tipo=proposta_candidata)"
    PROPOSTA_CANDIDATA |o--o| INSTRUMENTO_EQUIPAMENTO : "aceita vira (nr_convenio = str(id_proposta), sem FK fisica)"

    USER {
        bigint id PK
        string name
        string email UK
        enum role "admin | colaborador | leitor"
        enum status "active | inactive | suspended"
    }

    INSTRUMENTO_EQUIPAMENTO {
        bigint id PK
        string nr_convenio UK "numero real | NUP SEI (FAF/TED) | id_proposta (Parceria TransfereGov)"
        string cnpj_convenente
        string nome_convenente
        string tipo_contratacao "Convenio | FAF | TED | Parceria TransfereGov"
        string tecnico_titular
        string tecnico_suplente
        string situacao_prestacao_contas "legado -- job de verificacao diario leve"
        datetime created_at
    }

    MARCO_CATALOGO {
        bigint id PK
        string codigo UK
        enum grupo "fase_geral | cronograma_fisico | regulatorio"
        int ordem
    }

    EVENTO_MARCO {
        bigint id PK
        bigint instrumento_id FK
        bigint marco_id FK
        date data_ocorrencia
        string status_regulatorio
        bigint autor_id FK
        datetime created_at
    }

    ACAO_MONITORAMENTO {
        bigint id PK
        bigint instrumento_id FK
        string descricao
        date data_prevista
        date data_conclusao "unico campo mutavel"
    }

    PROPOSTA_CANDIDATA {
        bigint id PK
        int id_proposta UK "chave de dedup -- TransfereGov, nunca comparado contra o legado"
        string cnpj_ente_recebedor
        string nm_proponente
        string ds_objeto
        string componente_batido "1 dos 8 COMPONENTES_ALVO"
        string equipamento_detectado "casamento contra EQUIPAMENTOS_ALVO"
        numeric vl_global_proposta
        string situacao_proposta
        date data_proposta
        jsonb metas_resumo
        bool tem_parceria
        string status "pendente | aceita | rejeitada"
        bigint revisado_por FK
        datetime revisado_em
        datetime created_at
    }

    NOTIFICACAO {
        bigint id PK
        string tipo "proposta_candidata | atualizacao_api | edicao_manual"
        string titulo
        string corpo
        bigint entidade_id "polimorfico por tipo, sem FK fisica"
        string nivel_minimo "RBAC, a definir"
        bool lida
        datetime created_at
    }

    AUDIT_LOG {
        bigint id PK
        bigint user_id FK
        string entity_name
        bigint entity_id
        string action
        jsonb details
        datetime created_at
    }
